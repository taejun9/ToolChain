    "qa": "npm run typecheck && npm run lint && npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@jsquash/webp": "^1.5.0",
    "@lucide/vue": "^1.67.0",
    "@vue-flow/core": "^1.48.2",
    "dexie": "^4.4.7",
    "fflate": "^0.8.3",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
